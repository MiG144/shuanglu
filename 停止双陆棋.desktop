[Desktop Entry]
# ===========================================================================
# Shuanglu Backgammon - stop background server (Linux desktop)
# Install: chmod +x this file, put the real path into "Exec", then launch.
# ===========================================================================
Type=Application
Name=停止双陆棋服务
Comment=结束双陆棋后台预览服务
# --- 修改为你的实际项目路径 ---
Exec=/usr/bin/env node /path/to/shuanglu/scripts/stop.mjs
# --------------------------------
Terminal=true
Categories=Game;Utility;