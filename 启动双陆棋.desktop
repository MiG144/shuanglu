[Desktop Entry]
# ===========================================================================
# Shuanglu Backgammon - one-click launcher (Linux desktop)
# Install: 1) copy this file to ~/.local/share/applications/ (or Desktop)
#          2) chmod +x 启动双陆棋.desktop
#          3) put the real project path into "Path" and "Exec" below
# ===========================================================================
Type=Application
Name=双陆棋
Comment=中式双陆棋 · 《谱双》规则 (PVE/PVP, 变体, 悔棋/复盘)
# --- 修改为你的实际项目路径（两处）---
Path=/home/USER/shuanglu
Exec=/usr/bin/env node /home/USER/shuanglu/scripts/launch.mjs
# -------------------------------------
Terminal=false
Categories=Game;BoardGame;
Keywords=backgammon;shuanglu;双陆;